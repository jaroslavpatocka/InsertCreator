# BEGIN InsertCreator bezpecnost
# Pokud na serveru .htaccess uz existuje, neprepisovat: tento blok vlozit na jeho zacatek.
# Pri chybe 500 tento blok smazat a web se vrati do puvodniho stavu.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Jeden den. Prodlouzit az po overeni, ze HTTPS funguje na vsech adresach.
  Header always set Strict-Transport-Security "max-age=86400"
  # camera=() je zamerne vynechano, dokud se fotoaparat neoveri na fyzickem telefonu.
  Header always set Permissions-Policy "geolocation=(), microphone=(), display-capture=()"
  # Google Analytics se nacita az po souhlasu z consent.js, v HTML neni zadny vlozeny skript.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"
</IfModule>
# END InsertCreator bezpecnost
